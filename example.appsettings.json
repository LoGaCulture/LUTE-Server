{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YourDBName.db"
  },
  "Jwt": {
    "Key": "__SET_ME__", // Replace with a random string of at least 32 characters
    "Issuer": "Your Issuer" // Replace with your organisation name or domain
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  // Set Enabled to true and fill in Username/Password to seed an admin account on first boot.
  // The admin will be forced to change their password on first login.
  "DefaultAdmin": {
    "Username": "admin", // Change this username
    "Password": "__SET_ME__", // Replace with a strong password
    "Enabled": false // Set to true only when seeding a new instance
  }
}
