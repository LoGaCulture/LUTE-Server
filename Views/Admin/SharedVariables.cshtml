@model IEnumerable<LUTE_Server.Models.SharedVariable>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Shared Variables";
}

<h2>Game Shared Variables</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Game ID</th>
            <th>UUID</th>
            <th>Variable Type</th>
            <th>Variable Name</th>
            <th>Data</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var variable in Model)
        {
            <tr>
                <td>@variable.Id</td>
                <td>@variable.GameId</td>
                <td>@variable.UUID</td>
                <td>@variable.VariableType</td>
                <td>@variable.VariableName</td>
                <td>@variable.Data</td>
                <td>@variable.CreatedAt</td>
                <td>
                    <form method="post" action="@Url.Action("DeleteSharedVariable", "SharedVariable", new { id = variable.Id })" onsubmit="return confirm('Are you sure you want to delete this shared variable?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

