@model IEnumerable<LUTE_Server.Models.Game>

@{
    ViewData["Title"] = "Shared Variables";
}

<div class="page-header">
    <h1>Shared Variables</h1>
</div>

<div class="split-pane">
    <!-- Left pane: Games -->
    <div class="pane" id="games-pane">
        <div class="pane-header">Games</div>
        @if (!Model.Any())
        {
            <div class="empty-state">No games yet.</div>
        }
        else
        {
            <ul class="pane-list">
                @foreach (var game in Model)
                {
                    <li>
                        <button hx-get="@Url.Action("SharedVariablesVariablesPartial", "Admin", new { gameId = game.Id })"
                                hx-target="#variables-pane"
                                hx-swap="innerHTML"
                                onclick="document.querySelectorAll('#games-pane .pane-list li').forEach(function(e){e.classList.remove('active');}); this.closest('li').classList.add('active'); document.getElementById('data-pane').innerHTML = '<div class=\'empty-state\'>Select a variable</div>';">
                            @game.Name
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <!-- Middle pane: Variables (loaded by htmx) -->
    <div class="pane" id="variables-pane">
        <div class="empty-state">Select a game</div>
    </div>

    <!-- Right pane: Data (loaded by htmx) -->
    <div class="pane" id="data-pane">
        <div class="empty-state">Select a variable</div>
    </div>
</div>
