@model IEnumerable<LUTE_Server.Models.SharedVariable>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Shared Variables";
}

<h2 class="text-center text-light">Game Shared Variables</h2>

<div class="table-responsive">
    <table class="table table-dark table-striped table-bordered">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Game ID</th>
                <th scope="col">UUID</th>
                <th scope="col">Variable Type</th>
                <th scope="col">Variable Name</th>
                <th scope="col">Data</th>
                <th scope="col">Created At</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var variable in Model)
            {
                <tr>
                    <td>@variable.Id</td>
                    <td class="text-truncate" style="max-width: 100px;" data-bs-toggle="tooltip" title="@variable.GameId">
                        @variable.GameId
                    </td>
                    <td class="text-truncate" style="max-width: 100px;" data-bs-toggle="tooltip" title="@variable.UUID">
                        @variable.UUID
                    </td>
                    <td>@variable.VariableType</td>
                    <td>@variable.VariableName</td>
                    <td>@variable.Data</td>
                    <td>@variable.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <form method="post" action="@Url.Action("DeleteSharedVariable", "SharedVariable", new { id = variable.Id })" onsubmit="return confirm('Are you sure you want to delete this shared variable?');">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
