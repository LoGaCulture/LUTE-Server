@model IEnumerable<LUTE_Server.Models.Game>

@{
    ViewData["Title"] = "Games";
}

<div class="section-header">
    <h1>Games</h1>
    <a href="#new-game" class="btn btn-primary" onclick="document.getElementById('new-game').open=true; return false;">+ New Game</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="table-wrap" style="margin-bottom: 28px;">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4"><div class="empty-state">No games yet — create one below.</div></td></tr>
            }
            @foreach (var game in Model)
            {
                <tr>
                    <td><strong>@game.Name</strong></td>
                    <td class="muted">
                        <details class="cell-expand">
                            <summary>@game.Description</summary>
                            <div class="cell-full">@game.Description</div>
                        </details>
                    </td>
                    <td class="muted">@game.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <div class="actions-row" style="margin: 0; gap: 6px;">
                            <a href="@Url.Action("DownloadSecrets", "Admin", new { gameId = game.Id })" class="btn btn-secondary btn-sm">Secrets</a>

                            <form asp-action="RegenerateToken" asp-route-gameId="@game.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-warning btn-sm"
                                    onclick="return confirm('Regenerate secret key? Existing Unity integrations for this game will break until updated.');">
                                    Regen Key
                                </button>
                            </form>

                            <a href="@Url.Action("EditGame", "Admin", new { gameId = game.Id })" class="btn btn-secondary btn-sm">Edit</a>

                            <form asp-action="DeleteGame" asp-route-gameId="@game.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this game? This cannot be undone.');">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Create New Game (collapsible) -->
<details class="collapsible" id="new-game">
    <summary class="btn btn-secondary">
        <span class="summary-arrow">▶</span>
        New Game
    </summary>
    <div class="collapsible-body" style="max-width: 560px;">
        <h3>Create New Game</h3>
        <form asp-action="CreateGame" method="post">
            <div class="form-group">
                <label for="gameName">Name</label>
                <input type="text" id="gameName" name="name" placeholder="Enter game name" required />
            </div>
            <div class="form-group">
                <label for="gameDescription">Description</label>
                <textarea id="gameDescription" name="description" placeholder="Enter game description" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Create Game</button>
        </form>
    </div>
</details>
