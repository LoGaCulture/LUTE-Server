@model LUTE_Server.ViewModels.PagedUserLogViewModel

@{
    ViewData["Title"] = "Logs";
    var levels = new[] { "INFO", "WARNING", "ERROR", "DEBUG" };
}

<div class="page-header">
    <h1>Logs</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@* UUID chip (set by clicking a UUID in the table — cleared here) *@
@if (!string.IsNullOrEmpty(Model.UUIDFilter))
{
    var shortUuid = Model.UUIDFilter.Length > 16 ? Model.UUIDFilter[..16] + "…" : Model.UUIDFilter;
    <div class="filter-bar" style="margin-bottom: 10px;">
        <span class="label-caps">UUID:</span>
        <span class="filter-chip">
            @shortUuid
            <a class="chip-clear" href="javascript:;"
               onclick="document.getElementById('active-uuid')?.remove(); htmx.trigger(document.getElementById('log-filters'), 'change'); return false;"
               title="Clear UUID filter">×</a>
        </span>
    </div>
}

@* ── Filter bar ─────────────────────────────────────────────────────────── *@
<form id="log-filters"
      hx-get="@Url.Action("UserLogs", "Admin")"
      hx-target="#logs-table-container"
      hx-swap="innerHTML"
      hx-push-url="true"
      hx-trigger="change">

    @* Hidden UUID passthrough *@
    @if (!string.IsNullOrEmpty(Model.UUIDFilter))
    {
        <input type="hidden" name="uuid" id="active-uuid" value="@Model.UUIDFilter" />
    }

    <div class="log-filters-bar">

        @* Game dropdown with per-game log counts *@
        <select name="gameId">
            <option value="">All games</option>
            @foreach (var gc in Model.GameCounts)
            {
                if (Model.GameIdFilter == gc.GameId)
                {
                    <option value="@gc.GameId" selected>@gc.Name (@gc.Count)</option>
                }
                else
                {
                    <option value="@gc.GameId">@gc.Name (@gc.Count)</option>
                }
            }
        </select>

        @* Log level chip-toggles *@
        <div class="level-chips">
            @foreach (var lvl in levels)
            {
                var cssClass = lvl.ToLower();
                var isChecked = Model.LogLevelFilters?.Contains(lvl) == true;
                <label class="level-chip level-@cssClass">
                    @if (isChecked)
                    {
                        <input type="checkbox" name="logLevel" value="@lvl" checked />
                    }
                    else
                    {
                        <input type="checkbox" name="logLevel" value="@lvl" />
                    }
                    @lvl
                </label>
            }
        </div>

        @* Date range preset *@
        <select name="datePreset" id="log-date-preset"
                onchange="toggleLogDates(this.value)">
            @{
                var presets = new[] {
                    ("", "Any time"),
                    ("today", "Today"),
                    ("7days", "Last 7 days"),
                    ("30days", "Last 30 days"),
                    ("custom", "Custom…")
                };
            }
            @foreach (var (val, label) in presets)
            {
                if (Model.DatePreset == val)
                {
                    <option value="@val" selected>@label</option>
                }
                else
                {
                    <option value="@val">@label</option>
                }
            }
        </select>

        @* Custom date range (shown only when "custom" is selected) *@
        <div class="date-custom @(Model.DatePreset == "custom" ? "visible" : "")" id="log-custom-dates">
            <input type="date" name="dateFrom" style="width:auto;"
                   value="@(Model.DateFrom?.ToString("yyyy-MM-dd") ?? "")"
                   hx-trigger="change"
                   hx-get="@Url.Action("UserLogs", "Admin")"
                   hx-include="#log-filters"
                   hx-target="#logs-table-container"
                   hx-swap="innerHTML"
                   hx-push-url="true" />
            <span class="sep">–</span>
            <input type="date" name="dateTo" style="width:auto;"
                   value="@(Model.DateTo?.ToString("yyyy-MM-dd") ?? "")"
                   hx-trigger="change"
                   hx-get="@Url.Action("UserLogs", "Admin")"
                   hx-include="#log-filters"
                   hx-target="#logs-table-container"
                   hx-swap="innerHTML"
                   hx-push-url="true" />
        </div>

        @* Free-text search (debounced live filtering) *@
        <input type="search" name="search"
               placeholder="Search messages…"
               value="@(Model.SearchFilter ?? "")"
               hx-trigger="keyup changed delay:350ms"
               hx-get="@Url.Action("UserLogs", "Admin")"
               hx-include="#log-filters"
               hx-target="#logs-table-container"
               hx-swap="innerHTML"
               hx-push-url="true" />

        @if (!string.IsNullOrEmpty(Model.GameIdFilter)
             || (Model.LogLevelFilters?.Length > 0)
             || !string.IsNullOrEmpty(Model.SearchFilter)
             || !string.IsNullOrEmpty(Model.DatePreset)
             || !string.IsNullOrEmpty(Model.UUIDFilter))
        {
            <a href="@Url.Action("UserLogs", "Admin")" class="btn btn-ghost btn-sm">Clear all</a>
        }

    </div>
</form>

@* ── Table container (replaced by htmx on filter change) ────────────────── *@
<div id="logs-table-container">
    @await Html.PartialAsync("_UserLogsTable", Model)
</div>

<script>
function toggleLogDates(val) {
    var el = document.getElementById('log-custom-dates');
    if (el) el.classList.toggle('visible', val === 'custom');
}
</script>
