@model LUTE_Server.Models.Game

@{
    ViewData["Title"] = "Edit Game";
}

<div class="page-header">
    <h1>Edit Game</h1>
</div>

<div class="card" style="max-width: 560px;">
    <form asp-action="EditGame" method="post">
        <div class="form-group">
            <label for="Name">Name</label>
            <input type="text" id="Name" name="Name" value="@Model.Name" required />
        </div>
        <div class="form-group">
            <label for="Description">Description</label>
            <textarea id="Description" name="Description" required>@Model.Description</textarea>
        </div>
        <div class="actions-row" style="margin-top: 8px;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Games", "Admin")" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>
