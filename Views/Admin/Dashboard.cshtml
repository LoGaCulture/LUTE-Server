@model LUTE_Server.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1>Dashboard</h1>
</div>

<!-- Stat tiles -->
<div class="stat-tiles">
    <div class="stat-tile">
        <div class="stat-number">@Model.TotalUsers</div>
        <div class="stat-label">Total Users</div>
    </div>
    <div class="stat-tile">
        <div class="stat-number">@Model.TotalGames</div>
        <div class="stat-label">Games</div>
    </div>
    <div class="stat-tile">
        <div class="stat-number">@Model.TotalLogs</div>
        <div class="stat-label">Total Logs</div>
    </div>
    <div class="stat-tile">
        <div class="stat-number">@Model.LogsLast7Days</div>
        <div class="stat-label">Logs (7 days)</div>
    </div>
</div>

<!-- Quick actions -->
<div class="actions-row" style="margin-bottom: 28px;">
    <a href="@Url.Action("Games", "Admin")" class="btn btn-primary">+ New Game</a>
    <a href="@Url.Action("UserLogs", "Admin")" class="btn btn-secondary">View Logs</a>
    <a href="@Url.Action("SharedVariables", "Admin")" class="btn btn-secondary">Shared Variables</a>
</div>

<!-- Downloads -->
<div class="downloads-form">
    <h3>Download Data</h3>
    <form asp-action="Download" method="post">
        <div class="form-row">
            <div class="form-col">
                <label>Game</label>
                <select name="gameId">
                    <option value="">All games</option>
                    @foreach (var game in Model.Games)
                    {
                        <option value="@game.Id">@game.Name</option>
                    }
                </select>
            </div>
            <div class="form-col">
                <label>Date range</label>
                <select name="datePreset" id="datePreset" onchange="toggleCustomDates(this.value)">
                    <option value="all">All time</option>
                    <option value="today">Today</option>
                    <option value="7days">Last 7 days</option>
                    <option value="30days">Last 30 days</option>
                    <option value="custom">Custom…</option>
                </select>
                <div class="date-custom" id="custom-date-row">
                    <input type="date" name="fromDate" style="width: auto; flex: 1;" />
                    <span style="color: var(--text-muted); align-self: center; padding: 0 4px;">–</span>
                    <input type="date" name="toDate" style="width: auto; flex: 1;" />
                </div>
            </div>
        </div>
        <div class="form-group">
            <label>Data type</label>
            <div class="type-group">
                <label class="type-option">
                    <input type="radio" name="type" value="logs" checked />
                    Logs
                </label>
                <label class="type-option">
                    <input type="radio" name="type" value="variables" />
                    Shared Variables
                </label>
                <label class="type-option">
                    <input type="radio" name="type" value="all" />
                    All Data
                </label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Download CSV</button>
    </form>
</div>

<script>
function toggleCustomDates(val) {
    var row = document.getElementById('custom-date-row');
    if (val === 'custom') {
        row.classList.add('visible');
    } else {
        row.classList.remove('visible');
    }
}
</script>
