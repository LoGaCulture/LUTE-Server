@model LUTE_Server.ViewModels.PagedUserViewModel

@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>Users</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Role</th>
                <th>Update Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="muted">@user.Id</td>
                    <td>@user.Username</td>
                    <td>
                        @{
                            var roleClass = user.Role switch {
                                UserRole.Admin         => "role-admin",
                                UserRole.GameDeveloper => "role-gamedeveloper",
                                _                      => "role-user"
                            };
                        }
                        <span class="badge @roleClass">@user.Role</span>
                    </td>
                    <td>
                        <form asp-action="UpdateUserRole" method="post" class="inline-form">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <select name="newRole">
                                @foreach (UserRole roleOption in Enum.GetValues(typeof(UserRole)))
                                {
                                    if (user.Role == roleOption)
                                    {
                                        <option value="@((int)roleOption)" selected>@roleOption</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)roleOption)">@roleOption</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn btn-secondary btn-sm">Save</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination-compact">
        @if (Model.CurrentPage > 1)
        {
            <a href="@Url.Action("Index", new { pageNumber = Model.CurrentPage - 1 })">‹ Prev</a>
            <span class="sep">·</span>
        }
        else
        {
            <span class="disabled">‹ Prev</span>
            <span class="sep">·</span>
        }
        <span class="page-info">Page @Model.CurrentPage of @Model.TotalPages</span>
        <span class="sep">·</span>
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a href="@Url.Action("Index", new { pageNumber = Model.CurrentPage + 1 })">Next ›</a>
        }
        else
        {
            <span class="disabled">Next ›</span>
        }
        <span class="jump-wrap">
            Go to
            <input type="number" class="jump-input" min="1" max="@Model.TotalPages"
                   onchange="if(this.value>=1&&this.value<=@Model.TotalPages)window.location='@Url.Action("Index")?pageNumber='+this.value"
                   placeholder="…" />
        </span>
    </div>
}
