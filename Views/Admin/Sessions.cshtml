@model IEnumerable<LUTE_Server.Models.Session>

@{
    ViewData["Title"] = "Sessions";
}

<div class="page-header">
    <h1>Sessions</h1>
</div>

<div class="alert alert-info">
    This view is read-only — session tracking endpoints are currently disabled.
    Session data shown here is historical.
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>UUID</th>
                <th>Game ID</th>
                <th>Start Time</th>
                <th>Last Activity</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6"><div class="empty-state">No session data recorded.</div></td></tr>
            }
            @foreach (var session in Model)
            {
                <tr>
                    <td class="muted">@session.Id</td>
                    <td class="mono">@session.UUID</td>
                    <td class="mono">@session.GameId</td>
                    <td class="muted">@session.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="muted">@session.LastActivity.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (session.IsActive)
                        {
                            <span class="badge log-info">Active</span>
                        }
                        else
                        {
                            <span class="badge role-user">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
