<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/favicon.png" type="image/png" />
    <title>@ViewData["Title"] — LUTE Server</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Nav(string a) =>
        action.Equals(a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string NavAny(string a, string b) =>
        (action.Equals(a, StringComparison.OrdinalIgnoreCase) ||
         action.Equals(b, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<div class="shell">

    <nav class="sidebar">
        <div class="sidebar-brand">
            <a href="@Url.Action("Dashboard", "Admin")">LUTE Server</a>
            <span class="brand-sub">Admin</span>
        </div>
        <ul class="sidebar-nav">
            <li class="@Nav("Dashboard")">
                <a href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
            </li>
            <li class="@Nav("Index")">
                <a href="@Url.Action("Index", "Admin")">Users</a>
            </li>
            <li class="@NavAny("Games", "EditGame")">
                <a href="@Url.Action("Games", "Admin")">Games</a>
            </li>
            <li class="@Nav("UserLogs")">
                <a href="@Url.Action("UserLogs", "Admin")">Logs</a>
            </li>
            <li class="@Nav("SharedVariables")">
                <a href="@Url.Action("SharedVariables", "Admin")">Shared Variables</a>
            </li>
            <li class="@Nav("Sessions")">
                <a href="@Url.Action("Sessions", "Admin")">Sessions</a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <span class="sidebar-user">@User.Identity!.Name</span>
            <form method="post" action="/api/auth/logout">
                <button type="submit" class="btn btn-ghost btn-sm">Log Out</button>
            </form>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

</div>

<script src="https://unpkg.com/htmx.org@2.0.3"></script>
</body>
</html>
